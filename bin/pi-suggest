#!/usr/bin/env bash
set -euo pipefail

if [ $# -eq 0 ]; then
  command_name="$(basename "$0")"
  echo "Usage: $command_name <prompt...>" >&2
  echo "  Converts a natural language prompt into a runnable shell command." >&2
  echo "  All arguments are forwarded to the 'pi' agent harness." >&2
  exit 1
fi

shell_name="$(basename "${SHELL:-bash}")"
kernel_name="$(uname -s)"

rules=(
  "Output only the shell command to run. No explanation, no markdown, no code fences. Just the raw command."
  "Only print the command most likely to match the user's intent. Do not print multiple options or alternatives."
  "Spell out ALL CLI flags in full (e.g., prefer --recursive over -R, --verbose over -v). Never use abbreviated or short-form flags."
  "Prefer standard, widely-available tools (GNU coreutils, curl, jq, etc.)."
  "If the user explicitly asks about a less common 3rd-party CLI tool (e.g. jj), use context7 to look up its documentation before generating the command."
  "The user's current shell is ${shell_name} (${kernel_name}). Only generate commands that are compatible with this shell."
)

system_prompt="You are a shell command generator. Follow these rules strictly:
$(printf -- '- %s\n' "${rules[@]}")"

cmd=$(pi --no-builtin-tools --no-skills --no-prompt-templates --no-themes --no-context-files --no-session --system-prompt "$system_prompt" --print "$@")

if [[ -t 1 ]]; then
  # If the script is running in an interactive terminal, prompt the user for confirmation before executing the command.
  echo "$cmd"
  printf 'Execute? [y/N] ' >&2; 
  read -r confirm
  if [[ "$confirm" =~ ^[Yy]$ ]]; then
    eval "$cmd"
  else
    exit 1
  fi
else
  # If not running interactively, write the command to stdout.
  echo "$cmd"
fi
