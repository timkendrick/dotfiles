#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<USAGE
Usage: $(basename "$0") <pid>

Print the process ID of <pid> and all its descendant processes.

Processes are listed one per line in breadth-first order.

Options:
  -h, --help  Show this help message
USAGE
}

log() {
  printf '%s\n' "$*" >&2
}

root=""
while (($# > 0)); do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      log "Unknown option: $1"
      usage >&2
      exit 1
      ;;
    *)
      if [[ -n "$root" ]]; then
        log "Unexpected argument: $1"
        usage >&2
        exit 1
      fi
      root="$1"
      ;;
  esac
  shift
done

if [[ -z "$root" ]]; then
  log "Missing required argument: <pid>"
  usage >&2
  exit 1
fi

if [[ ! "$root" =~ ^[0-9]+$ ]]; then
  log "Invalid PID: $root"
  usage >&2
  exit 1
fi

ps -A -o pid=,ppid= | awk -v root="$root" '
  { c[$2] = c[$2] " " $1 }
  END {
    q[1] = root
    h = t = 1
    while (h <= t) {
      p = q[h++]
      print p
      n = split(c[p], k, " ")
      for (i = 1; i <= n; i++) q[++t] = k[i]
    }
  }'
