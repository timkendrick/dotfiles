#!/usr/bin/env bash
set -euo pipefail

# macOS Sandbox Wrapper Script
# Usage: sandbox [write_path1, write_path2, ...] -- <command> [arguments...]

# Print the static base sandbox profile template to stdout.
print_sandbox_template() {
    cat <<'EOF'
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; macOS Sandbox Configuration Template
;; Reference: sandbox-exec(1)
;;
;; Required profile parameters (provided via `-D key=value`):
;; - HOME - User's home directory: `$(realpath "$HOME")`
;; - TMPDIR - Temp directory: `$(realpath "$TMPDIR")`
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(version 1)
EOF
}

# Configuration paths
_SANDBOX_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/sandbox"
_SANDBOX_PLUGINS_DIR="${_SANDBOX_CONFIG_DIR}/plugins"
_SANDBOX_PROFILES_DIR="${_SANDBOX_CONFIG_DIR}/profiles"

# List all available profiles with their definition file paths.
# Output: one line per profile: "<name>  <path>"
list_profiles() {
    [[ -d "$_SANDBOX_PROFILES_DIR" ]] || return 0
    local file name
    for file in "$_SANDBOX_PROFILES_DIR"/*.sandboxrc; do
        [[ -e "$file" ]] || continue
        name=$(basename "$file")
        name="${name%.sandboxrc}"
        printf '%-16s%s\n' "$name" "$file"
    done | sort
}

# Find the definition file for a profile by name.
# Prints the file path, or nothing if not found.
find_profile() {
    local name="$1"
    [[ -d "$_SANDBOX_PROFILES_DIR" ]] || return 0
    if [[ -f "$_SANDBOX_PROFILES_DIR/$name.sandboxrc" ]]; then
        echo "$_SANDBOX_PROFILES_DIR/$name.sandboxrc"
    fi
}

# List all available plugins with their definition file paths.
# Output: one line per plugin: "<name>  <path> [<path>]"
list_plugins() {
    [[ -d "$_SANDBOX_PLUGINS_DIR" ]] || return 0
    local file name
    for file in "$_SANDBOX_PLUGINS_DIR"/*.sb "$_SANDBOX_PLUGINS_DIR"/*.sh "$_SANDBOX_PLUGINS_DIR"/*.env; do
        [[ -e "$file" ]] || continue
        name=$(basename "$file")
        echo "${name%.*}"
    done | sort -u | while IFS= read -r name; do
        printf '%-16s%s\n' "$name" "$(find_plugin "$name" | paste -sd ' ' -)"
    done
}

# Find the definition files for a plugin by name.
# Prints the rules file (.sb or .sh) and the environment file (.env), one per line.
# Prints nothing if the plugin does not exist.
find_plugin() {
    local name="$1"
    [[ -d "$_SANDBOX_PLUGINS_DIR" ]] || return 0
    if [[ -f "$_SANDBOX_PLUGINS_DIR/$name.sb" ]]; then
        echo "$_SANDBOX_PLUGINS_DIR/$name.sb"
    elif [[ -f "$_SANDBOX_PLUGINS_DIR/$name.sh" ]]; then
        echo "$_SANDBOX_PLUGINS_DIR/$name.sh"
    fi
    if [[ -f "$_SANDBOX_PLUGINS_DIR/$name.env" ]]; then
        echo "$_SANDBOX_PLUGINS_DIR/$name.env"
    fi
}

# A plain environment variable name
_sandbox_env_name_regex='^[A-Za-z_][A-Za-z0-9_]*$'
# An environment variable name with an optional trailing * (prefix match), or a lone * (matches every name)
_sandbox_env_pattern_regex='^([A-Za-z_][A-Za-z0-9_]*\*?|\*)$'

# Exit with an error if $1 is not a valid environment variable name or name prefix pattern.
# $2 = the source of the pattern, for the error message
validate_env_pattern() {
    local pattern="$1"
    local origin="$2"
    if ! [[ "$pattern" =~ $_sandbox_env_pattern_regex ]]; then
        echo "Error: Invalid environment variable pattern '$pattern' in $origin." >&2
        exit 1
    fi
}

# Read the environment variable patterns from a plugin .env file into _sandbox_plugin_env_patterns.
# Blank lines and lines starting with # are ignored. Each other line holds one pattern.
# $1 = path to the file
read_env_file() {
    local file="$1"
    local line
    _sandbox_plugin_env_patterns=()
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -z "$line" || "$line" == \#* ]] && continue
        validate_env_pattern "$line" "$file"
        _sandbox_plugin_env_patterns+=("$line")
    done < "$file"
}

# Parse an rc/profile file and print one token per line to stdout.
# Blank lines and lines starting with # are ignored.
# ~ is expanded to $HOME. Each line is word-split into tokens.
# $1 = path to the file
parse_rc_file() {
    local line tokens
    local file="$1"
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -z "$line" || "$line" == \#* ]] && continue
        line="${line//'~'/$HOME}"
        read -ra tokens <<< "$line"
        printf '%s\n' "${tokens[@]+"${tokens[@]}"}"
    done < "$file"
}

usage() {
    cat <<EOF
macOS Sandbox Wrapper
Run commands in a restricted sandbox environment

Usage:
  $(basename "$0") [options]  Print the generated sandbox-exec profile to stdout
  $(basename "$0") [options] -- <command> [arguments...]  Run command inside the sandbox

Options:
  -h, --help                  Show this help message and exit
  --dir <path>                Allow read+write access to a specific directory and its children
  --dir-readonly <path>       Allow read-only access to a specific directory and its children
  --path <path>               Allow read+write access to an exact path (no children)
  --path-readonly <path>      Allow read-only access to an exact path (no children)
  --pattern <regex>           Allow read+write access to paths matching a regex pattern
  --pattern-readonly <regex>  Allow read-only access to paths matching a regex pattern
  --env <name>                Pass a host environment variable into the sandbox (a trailing * matches a name prefix)
  --env <name>=<value>        Set an environment variable inside the sandbox
  --plugin <name>, --plugin=<name>  Enable a named plugin (see below for available plugins)
  --profile <name>, --profile=<name>  Apply a named profile (see below for available profiles)

Available profiles:
$(list_profiles | sed 's/^/  /')

Available plugins:
$(list_plugins | sed 's/^/  /')

Examples:
  # Allow writing to specific directories
  $(basename "$0") --dir ./src --dir ./build -- npm run build

  # Allow writing to paths matching a pattern (e.g. temporary logs)
  $(basename "$0") --pattern "^/var/folders/.*/*.log$" -- touch "$(mktemp -d)"/test.log

  # Preview the generated sandbox profile
  $(basename "$0") --dir ./src

  # Read-only execution (default)
  $(basename "$0") -- ls -la

The default sandbox has no permissions; all access must be explicitly granted.

The sandboxed command receives only whitelisted environment variables, plus
SANDBOX=1. Plugins and --env options add variables to the whitelist:
  - A plugin may include a <name>.env file next to its rules file, or only a
    <name>.env file
  - Each line of a .env file holds one variable name, optionally ending in *
    to match a name prefix (e.g. AWS_PROFILE or AWS_*)
  - Blank lines and lines starting with # are ignored
  - Variables that are not set on the host are skipped
  - Bash always sets PWD and SHLVL for the sandboxed command

If a .sandboxrc file exists in the current working directory, it is read as
additional sandbox arguments (appended after any CLI arguments). Blank lines
and lines starting with # are ignored. Each line may contain one or more
flags (e.g. "--dir ~/.config" or "--pattern '^/Volumes/dev/'").

If a .sandboxignore file exists in the current working directory, it is read to
deny read access to additional paths. The file follows gitignore glob syntax:
  - Blank lines and lines starting with # are ignored
  - Patterns without a / match files in any directory (e.g. *.log)
  - Patterns containing a / are anchored to the directory containing .sandboxignore
  - A trailing / restricts the match to directories
  - Prefix ! to negate a rule (re-allow a path blocked by a prior rule)
  - Glob specials: * matches within a path segment, ** matches across segments,
    ? matches any single character, [abc] matches a character class
EOF
}

# ---------------------------------------------------------------------------

# Convert a single gitignore-style glob pattern (already stripped of leading !
# and trailing /) to an extended-regex string anchored to $base_dir.
# $1 = base directory (absolute, no trailing slash)
# $2 = the pattern
# $3 = "dir" if the original pattern had a trailing slash (directory-only)
# Prints the regex, or nothing if the pattern should be skipped.
gitignore_pattern_to_regex() {
    local base="$1"
    local pat="$2"
    local dir_only="${3:-}"

    # Escape the base path for use in a regex
    local escaped_base
    escaped_base="$(printf '%s' "$base" | sed 's/[.[\*^$()+{}|?]/\\&/g')"

    # Determine if the pattern is anchored (contains a / somewhere other than
    # at the very end, which has already been stripped, or starts with /)
    local anchored=false
    if [[ "$pat" == */* ]]; then
        anchored=true
    fi

    # Strip a leading slash (it just means "anchored to base", which we handle)
    pat="${pat#/}"

    # Translate the glob pattern to a regex fragment.
    # Process character by character so we can handle ** correctly.
    local regex_fragment=""
    local i=0
    local len="${#pat}"
    while (( i < len )); do
        local ch="${pat:$i:1}"
        case "$ch" in
            '*')
                if [[ "${pat:$i:2}" == "**" ]]; then
                    # ** matches anything including path separators
                    regex_fragment+=".*"
                    (( i += 2 )) || true
                    # Consume a surrounding / so **/foo and foo/**/bar work
                    # naturally: eat a leading / after ** when present
                    if [[ "${pat:$i:1}" == "/" ]]; then
                        regex_fragment+="(.*/)?"
                        (( i += 1 )) || true
                    fi
                    continue
                else
                    # * matches anything except /
                    regex_fragment+="[^/]*"
                fi
                ;;
            '?')
                regex_fragment+="[^/]"
                ;;
            '.')
                regex_fragment+="\."
                ;;
            '[')
                # Pass character classes through verbatim until the closing ]
                local class="["
                (( i += 1 )) || true
                while (( i < len )) && [[ "${pat:$i:1}" != "]" ]]; do
                    class+="${pat:$i:1}"
                    (( i += 1 )) || true
                done
                class+="]"
                regex_fragment+="$class"
                ;;
            '+' | '^' | '$' | '{' | '}' | '(' | ')' | '|' | '\\')
                regex_fragment+="\\$ch"
                ;;
            *)
                regex_fragment+="$ch"
                ;;
        esac
        (( i += 1 )) || true
    done

    local regex
    if $anchored; then
        # Anchored: pattern must match relative to $base
        if [[ -n "$dir_only" ]]; then
            # Must match a directory: path is either exactly this dir or a subpath
            regex="^${escaped_base}/${regex_fragment}(/.*)?$"
        else
            regex="^${escaped_base}/${regex_fragment}(/.*)?$"
        fi
    else
        # Unanchored: pattern matches a filename in any directory under $base,
        # or $base itself
        if [[ -n "$dir_only" ]]; then
            regex="^${escaped_base}(/.*)/${regex_fragment}(/.*)?$"
        else
            regex="^${escaped_base}(/.*)?/${regex_fragment}(/.*)?$"
        fi
    fi

    printf '%s' "$regex"
}

# ---------------------------------------------------------------------------
# Sandbox profile expression factory functions.
# Each function prints a sandbox scheme expression to stdout.
# Compose them with $(...) substitution.
# ---------------------------------------------------------------------------

# Location expressions
literal_expression() { printf '(literal %s)' "$1"; }
subpath_expression() { printf '(subpath %s)' "$1"; }
regex_expression()   { printf '(regex #"%s")' "$1"; }

# Quoted helpers for plain absolute paths (the common case for --dir / --path)
literal_path_expression()  { literal_expression "\"$1\""; }
subpath_path_expression()  { subpath_expression "\"$1\""; }

# Permission rule constructors
allow_read_rule()       { printf '(allow file-read* %s)'            "$1"; }
allow_read_write_rule() { printf '(allow file-read* file-write* %s)' "$1"; }
deny_read_rule()        { printf '(deny file-read* %s)'             "$1"; }

# Parse a .sandboxignore file and emit sandbox profile rule strings, one per line.
# Deny rules are emitted first, then allow (negation) rules so that negations win.
# $1 = path to the .sandboxignore file
# $2 = base directory (absolute, no trailing slash)
emit_sandboxignore_rules() {
    local line rule
    local file="$1"
    local base="$2"

    local deny_rules=()
    local allow_rules=()

    while IFS= read -r line || [[ -n "$line" ]]; do
        # Skip blank lines and comments
        [[ -z "$line" || "$line" == \#* ]] && continue

        local negated=false
        if [[ "$line" == \!* ]]; then
            negated=true
            line="${line:1}"
        fi

        # Strip trailing /  (record whether it was present)
        local dir_only=""
        if [[ "$line" == */ ]]; then
            dir_only="dir"
            line="${line%/}"
        fi

        # Skip empty pattern after stripping
        [[ -z "$line" ]] && continue

        local regex
        regex="$(gitignore_pattern_to_regex "$base" "$line" "$dir_only")"
        [[ -z "$regex" ]] && continue

        if $negated; then
            allow_rules+=("$(allow_read_rule "$(regex_expression "$regex")")")
        else
            deny_rules+=("$(deny_read_rule "$(regex_expression "$regex")")")
        fi
    done < "$file"

    for rule in "${deny_rules[@]+"${deny_rules[@]}"}"; do
        echo "$rule"
    done
    for rule in "${allow_rules[@]+"${allow_rules[@]}"}"; do
        echo "$rule"
    done
}

# Resolve a path argument to an absolute path and print it.
# $1 = the raw path value
resolve_dir() {
    local arg="$1"
    if [[ -d "$arg" ]]; then
        cd "$arg" && pwd
    elif [[ -f "$arg" ]]; then
        echo "$(cd "$(dirname "$arg")" && pwd)/$(basename "$arg")"
    elif [[ "$arg" == /* ]]; then
        echo "$arg"
    else
        echo "$(pwd)/$arg"
    fi
}

# Collect CLI option tokens (everything before --) and _SANDBOX_COMMAND_ARGS (everything after).
# Also handle --help early since it exits immediately.
_SANDBOX_HAS_COMMAND=false
_SANDBOX_COMMAND_ARGS=()
_sandbox_cli_args=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --help|-h)
            usage
            exit 0
            ;;
        --)
            shift
            _SANDBOX_HAS_COMMAND=true
            _SANDBOX_COMMAND_ARGS=("$@")
            break
            ;;
        *)
            _sandbox_cli_args+=("$1")
            shift
            ;;
    esac
done

# Collect .sandboxrc tokens, if the file exists.
_sandbox_rc_args=()
_SANDBOX_SANDBOXRC_FILE="$(pwd)/.sandboxrc"
if [[ -f "$_SANDBOX_SANDBOXRC_FILE" ]]; then
    while IFS= read -r _sandbox_token; do _sandbox_rc_args+=("$_sandbox_token"); done < <(parse_rc_file "$_SANDBOX_SANDBOXRC_FILE")
fi

# Parse all option tokens - CLI args first, then rc args - and accumulate
# sandbox profile rule blocks into _sandbox_profile_sections.
_sandbox_profile_sections=()
_sandbox_section_depth=0

# Append a commented section (and optional rule content) to _sandbox_profile_sections,
# indented according to the current _sandbox_section_depth.
add_section() {
    local comment="$1"
    local rule="${2-}"
    local indent
    indent=$(printf '%*s' "$_sandbox_section_depth" '' | tr ' ' $'\t')

    local entry="${indent};; ${comment}"
    if [[ -n "$rule" ]]; then
        local indented_rule
        indented_rule=$(printf '%s\n' "$rule" | sed "s/^/${indent}/")
        entry+=$'\n'"${indented_rule}"
    fi
    _sandbox_profile_sections+=("$entry")
}

# Process an argument list and append sandbox rules to _sandbox_profile_sections.
# Called recursively for --profile expansion (depth-first).
process_args() {
    local plugin_name plugin_files plugin_file plugin_rules plugin_section env_name profile_name profile_file token
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dir)
                if [[ -z "${2-}" ]]; then
                    echo "Error: --dir requires a path." >&2
                    exit 1
                fi
                add_section "--dir $2" "$(allow_read_write_rule "$(subpath_path_expression "$(resolve_dir "$2")")")" 
                shift 2
                ;;
            --dir-readonly)
                if [[ -z "${2-}" ]]; then
                    echo "Error: --dir-readonly requires a path." >&2
                    exit 1
                fi
                add_section "--dir-readonly $2" "$(allow_read_rule "$(subpath_path_expression "$(resolve_dir "$2")")")" 
                shift 2
                ;;
            --path)
                if [[ -z "${2-}" ]]; then
                    echo "Error: --path requires a path." >&2
                    exit 1
                fi
                add_section "--path $2" "$(allow_read_write_rule "$(literal_path_expression "$(resolve_dir "$2")")")" 
                shift 2
                ;;
            --path-readonly)
                if [[ -z "${2-}" ]]; then
                    echo "Error: --path-readonly requires a path." >&2
                    exit 1
                fi
                add_section "--path-readonly $2" "$(allow_read_rule "$(literal_path_expression "$(resolve_dir "$2")")")" 
                shift 2
                ;;
            --pattern)
                if [[ -z "${2-}" ]]; then
                    echo "Error: --pattern requires a regex." >&2
                    exit 1
                fi
                add_section "--pattern $2" "$(allow_read_write_rule "$(regex_expression "$2")")"
                shift 2
                ;;
            --pattern-readonly)
                if [[ -z "${2-}" ]]; then
                    echo "Error: --pattern-readonly requires a regex." >&2
                    exit 1
                fi
                add_section "--pattern-readonly $2" "$(allow_read_rule "$(regex_expression "$2")")"
                shift 2
                ;;
            --plugin|--plugin=*)
                if [[ "$1" == --plugin=* ]]; then
                    plugin_name="${1#--plugin=}"
                    shift
                else
                    if [[ $# -lt 2 ]]; then
                        echo "Error: --plugin requires a plugin name." >&2
                        usage >&2
                        exit 1
                    fi
                    plugin_name="$2"
                    shift 2
                fi
                plugin_files=()
                while IFS= read -r plugin_file; do plugin_files+=("$plugin_file"); done < <(find_plugin "$plugin_name")
                if [[ ${#plugin_files[@]} -eq 0 ]]; then
                    echo "Error: Unknown plugin '$plugin_name'." >&2
                    usage >&2
                    exit 1
                fi
                plugin_rules=""
                _sandbox_plugin_env_patterns=()
                for plugin_file in "${plugin_files[@]}"; do
                    case "$plugin_file" in
                        *.sh) plugin_rules=$(bash "$plugin_file") ;;
                        *.sb) plugin_rules=$(cat "$plugin_file") ;;
                        *.env) read_env_file "$plugin_file" ;;
                    esac
                done
                plugin_section=""
                if [[ ${#_sandbox_plugin_env_patterns[@]} -gt 0 ]]; then
                    _sandbox_env_patterns+=("${_sandbox_plugin_env_patterns[@]}")
                    plugin_section=";; env: ${_sandbox_plugin_env_patterns[*]}"
                fi
                if [[ -n "$plugin_rules" ]]; then
                    plugin_section+="${plugin_section:+$'\n'}${plugin_rules}"
                fi
                add_section "--plugin $plugin_name" "$plugin_section"
                ;;
            --env)
                if [[ -z "${2-}" ]]; then
                    echo "Error: --env requires a variable name." >&2
                    exit 1
                fi
                if [[ "$2" == *=* ]]; then
                    env_name="${2%%=*}"
                    if ! [[ "$env_name" =~ $_sandbox_env_name_regex ]]; then
                        echo "Error: --env <name>=<value> requires a plain variable name, not '$env_name'." >&2
                        exit 1
                    fi
                    _sandbox_env_assignments+=("$2")
                else
                    env_name="$2"
                    validate_env_pattern "$env_name" "--env $env_name"
                    _sandbox_env_patterns+=("$env_name")
                fi
                add_section "--env $env_name"
                shift 2
                ;;
            --profile|--profile=*)
                if [[ "$1" == --profile=* ]]; then
                    profile_name="${1#--profile=}"
                    shift
                else
                    if [[ $# -lt 2 ]]; then
                        echo "Error: --profile requires a name." >&2
                        usage >&2
                        exit 1
                    fi
                    profile_name="$2"
                    shift 2
                fi
                profile_file=$(find_profile "$profile_name")
                if [[ -z "$profile_file" ]]; then
                    echo "Error: Unknown profile '$profile_name'." >&2
                    usage >&2
                    exit 1
                fi
                add_section "--profile $profile_name"
                (( _sandbox_section_depth++ ))
                local profile_tokens=()
                while IFS= read -r token; do profile_tokens+=("$token"); done < <(parse_rc_file "$profile_file")
                process_args "${profile_tokens[@]+"${profile_tokens[@]}"}"
                (( _sandbox_section_depth-- ))
                ;;
            *)
                echo "Error: Unknown argument '$1'." >&2
                usage >&2
                exit 1
                ;;
        esac
    done
}

# Environment variable whitelist, accumulated by process_args
_sandbox_env_patterns=()
_sandbox_env_assignments=()

add_section "Deny default rules" "(deny default)"
process_args "${_sandbox_cli_args[@]+${_sandbox_cli_args[@]}}" "${_sandbox_rc_args[@]+${_sandbox_rc_args[@]}}"

# Validate arguments
if [[ "$_SANDBOX_HAS_COMMAND" == true && ${#_SANDBOX_COMMAND_ARGS[@]} -eq 0 ]]; then
    echo "Error: No command provided after '--'." >&2
    usage >&2
    exit 1
fi

# Add rules from .sandboxignore, if present
_SANDBOX_SANDBOXIGNORE_FILE="$(pwd)/.sandboxignore"
if [[ -f "$_SANDBOX_SANDBOXIGNORE_FILE" ]]; then
    while IFS= read -r _sandbox_rule; do
        _sandbox_profile_sections+=("$_sandbox_rule")
    done < <(emit_sandboxignore_rules "$_SANDBOX_SANDBOXIGNORE_FILE" "$(pwd)")
fi

# Create the sandbox profile (template + dynamic rules)
_sandbox_profile_source=$(
    print_sandbox_template
    echo ""
    for _sandbox_section in "${_sandbox_profile_sections[@]+"${_sandbox_profile_sections[@]}"}"; do
        echo "$_sandbox_section"
        echo ""
    done
)

# If no command was specified, write the profile to stdout and exit
if [[ "$_SANDBOX_HAS_COMMAND" == false ]]; then
    echo "$_sandbox_profile_source"
    exit 0
fi

# Remove all exported variables and functions that the whitelist does not match.
# Then export the explicit --env assignments.
# This keeps variable values out of the sandbox-exec argument list.
apply_env_whitelist() {
    local name pattern allowed assignment function_declaration
    while IFS= read -r name; do
        allowed=false
        for pattern in "${_sandbox_env_patterns[@]+"${_sandbox_env_patterns[@]}"}"; do
            if [[ "$pattern" == *\* ]]; then
                [[ "$name" == "${pattern%\*}"* ]] && allowed=true
            else
                [[ "$name" == "$pattern" ]] && allowed=true
            fi
            [[ "$allowed" == true ]] && break
        done
        [[ "$allowed" == true ]] && continue
        if ! [[ "$name" =~ $_sandbox_env_name_regex ]]; then
            echo "Error: Cannot remove environment variable '$name' because its name is not valid in bash." >&2
            exit 1
        fi
        # shellcheck disable=SC2163
        export -n "$name"
    done < <(compgen -e)
    while IFS= read -r function_declaration; do
        export -n -f "${function_declaration##* }"
    done < <(declare -Fx)
    for assignment in "${_sandbox_env_assignments[@]+"${_sandbox_env_assignments[@]}"}"; do
        # shellcheck disable=SC2163
        export "$assignment"
    done
    export SANDBOX=1
}

_sandbox_home="$(realpath "$HOME")"
_sandbox_tmpdir="$(realpath "$TMPDIR")"
apply_env_whitelist

# Execute the command in the sandbox environment
exec sandbox-exec -p "$_sandbox_profile_source" -D HOME="$_sandbox_home" -D TMPDIR="$_sandbox_tmpdir" "${_SANDBOX_COMMAND_ARGS[@]}"
