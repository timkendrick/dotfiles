{
  "packages": [
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@narumitw/pi-lsp",
    "npm:@tintinweb/pi-tasks",
    "npm:@upstash/context7-pi",
    "npm:pi-caffeinate",
    "npm:pi-compact-transcript",
    "npm:pi-goal-x",
    "npm:pi-herdr-agents",
    "npm:pi-powerline-footer",
    "npm:pi-system-prompt",
    "npm:pi-web-search"
  ],
  "defaultTools": [
    "read",
    "bash",
    "edit",
    "write",
    "grep",
    "find",
    "ls"
  ],
  "doubleEscapeAction": "tree",
  "hideThinkingBlock": false,
  "treeFilterMode": "no-tools",
  "warnings": {
    "anthropicExtraUsage": false
  },
  "retry": {
    "baseDelayMs": 1000,
    "maxRetries": 15
  },
  "powerline": {
    "preset": "default",
    "layout": {
      "left": [
        "custom:sandbox",
        "model",
        "thinking",
        "shell_mode",
        "path",
        "git",
        "queue",
        "context_pct",
        "cache_read",
        "cost"
      ]
    },
    "customItems": [
      {
        "id": "sandbox",
        "selfColorize": true
      }
    ]
  }
}
