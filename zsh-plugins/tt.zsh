alias tt-worktree-create='cd "$(tt checkout --worktree "$(tt create)" || echo ".")"'
alias tt-worktree-checkout='cd "$(tt checkout --rebase --worktree "$(tt select)" || echo ".")"'
alias tt-worktree-select='cd "$(tt worktree show --name "$(tt worktree list --quiet | fzf)" || echo ".")"'
alias tt-worktree-parent='cd "$(tt worktree show --name "$(tt parent)" || echo ".")"'
alias tt-worktree-delete='tt worktree delete "$(tt worktree show --name "$(tt worktree list --quiet | fzf)")"'
alias tt-worktree-delete-current='TASK_ID="$(tt current)" PARENT_ID="$(tt parent)" && PARENT_PATH="$(tt worktree show --name "$PARENT_ID" || tt repo)" && (cd "$PARENT_PATH" && tt worktree delete "$(tt worktree show --name "$TASK_ID")" && tt sync && tt refresh) && exit'
alias tt-context-add='(file="$(ls .agents/plans/*.md | fzf)" && tt task context add --title "$(edit)" < "$file" && rm "$file")'
alias tt-create-inline='tt checkout "$(tt create)"'
alias tt-checkout-inline='tt checkout --rebase "$(tt select)"'
alias tt-checkout-parent='tt checkout "$(tt parent)"'
alias tt-pi='pi -- "$(tt prompt | edit)"'
alias tt-pi-skill='pi -- "$(tt prompt --message "/skill:$(pi-list-skills | fzf)" | edit)"'
